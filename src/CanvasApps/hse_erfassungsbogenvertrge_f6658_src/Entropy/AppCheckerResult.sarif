      "tool": {
        "driver": {
          "fullName": "PowerApps app checker",
          "name": "PowerApps app checker",
          "rules": [
            {
              "id": "app-WrnNoNavigateInOnStart",
              "messageStrings": {
                "issue": {
                  "text": "Navigate is not suggested in OnStart. Use the StartScreen property instead for better performance."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "Medium",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrInvalidName",
              "messageStrings": {
                "issue": {
                  "text": "Name isn't valid. '{0}' isn't recognized."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Remove or correct the reference to the name that isn't valid."
                ],
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrInvalidArgs-Func",
              "messageStrings": {
                "issue": {
                  "text": "The function '{0}' has some invalid arguments."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrInvalidDot",
              "messageStrings": {
                "issue": {
                  "text": "The '.' operator cannot be used on {0} values."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrTypeError-Arg-Expected-Found",
              "messageStrings": {
                "issue": {
                  "text": "The type of this argument '{0}' does not match the expected type '{1}'. Found type '{2}'."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrIncompatibleCtxtVariableTypes",
              "messageStrings": {
                "issue": {
                  "text": "Incompatible type. We can't evaluate your formula because the context variable types are incompatible with the types of values in other places in your app."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Look at places where you use a context variable and make sure that the type (e.g., text, number, date, record, table) is compatible."
                ],
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrFunctionExpectsSameScreenForSelect",
              "messageStrings": {
                "issue": {
                  "text": "Select of a control that is not on this screen."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-WarnInvalidTypeForVariableDefinition",
              "messageStrings": {
                "issue": {
                  "text": "The variable {0} needs to have a non-Blank type. If this is the only place that {0} is defined, resolve this by adding another definition elsewhere that assigns a non-Blank value to this variable."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "Medium",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "acc-AccessibleLabelNeeded",
              "messageStrings": {
                "issue": {
                  "text": "Missing accessible label"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Edit the accessible label property to describe the item."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls."
              }
            },
            {
              "id": "acc-TabIndexShouldBeDefinedForInteractiveControl",
              "messageStrings": {
                "issue": {
                  "text": "Missing tab stop"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "People who use the keyboard with your app will not be able to access this element without a tab stop."
              }
            },
            {
              "id": "acc-FocusBorderShouldBeVisible",
              "messageStrings": {
                "issue": {
                  "text": "Focus isn't showing"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Change the FocusedBorderThickness property to be more than 0."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app."
              }
            },
            {
              "id": "acc-ReadableScreenNameNeeded",
              "messageStrings": {
                "issue": {
                  "text": "Revise screen name"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Give the screen  a title that describes what's on the screen or what it's used for."
                ],
                "level": "Low",
                "primaryCategory": "accessibility",
                "whyFix": "People who are blind, have low vision, or a reading disability rely on screen titles to navigate using the screen reader. "
              }
            },
            {
              "id": "app-UnusedVariables",
              "messageStrings": {
                "issue": {
                  "text": "Nicht verwendete Variable"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Entfernen Sie die nicht verwendete Variable."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Diese Variable ist deklariert, wird aber von keinem Steuerelement referenziert und daher nicht benötigt."
              }
            },
            {
              "id": "app-CollectDelegatableDataSource",
              "messageStrings": {
                "issue": {
                  "text": "Die aus der Datenquelle abgerufenen Zeilen sind möglicherweise nicht vollständig."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Schränken Sie die von der Datenquelle erfassten Daten ein, indem Sie die Formel \"ClearCollect(colGeschäftsführer; Geschäftsführer)\" mit einer Filterfunktion wie \"Filter\" oder \"Search\" aktualisieren."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Bei Verwendung der Collect-Funktion zum Erstellen einer Sammlung direkt aus einer verbundenen Datenquelle wird möglicherweise nicht jede Zeile geladen, wenn die Datenquelle zu groß ist."
              }
            },
            {
              "id": "app-DataSourceDefaultMaxRowsLimit",
              "messageStrings": {
                "issue": {
                  "text": "Der Grenzwert für Datenzeilen für nicht delegierbare Abfragen ist größer als 500."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Aktualisieren Sie \"Grenzwert für Datenzeilen für nicht delegierbare Abfragen\" in den erweiterten App-Einstellungen."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Ein \"Grenzwert für Datenzeilen\" von mehr als 500 kann bei Ausführung nicht delegierbarer Abfragen zu einer langsameren App führen, weil die App jede Zeile selbst verarbeiten muss, anstatt die Abfrage auf dem Server auszuführen."
              }
            },
            {
              "id": "app-InefficientDelayLoading",
              "messageStrings": {
                "issue": {
                  "text": "Ineffizientes verzögertes Laden"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Verwenden Sie Variablen, Sammlungen und Navigationskontext, um den Zustand stattdessen bildschirmübergreifend freizugeben."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Steuerelemente, die auf Steuerelemente in anderen Bildschirmen verweisen, können das Laden von Apps und das Navigieren darin verlangsamen. In diesen Fällen ist die App möglicherweise gezwungen, die anderen Bildschirme sofort zu laden, statt zu warten, bis der Benutzer zum jeweiligen Bildschirm navigiert."
              }
            },
            {
              "id": "app-NumericPropertySizeWarning",
              "messageStrings": {
                "issue": {
                  "text": "Das Hochladen großer Dateien von bis zu 10 MB ist zulässig."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Prüfen Sie, ob Anlagen dieser Größe erforderlich sind."
                ],
                "level": "Low",
                "primaryCategory": "performance",
                "whyFix": "Wir empfehlen Tests auf allen unterstützten Plattformen, um sicherzustellen, dass Anlagen dieser Größe erfolgreich hochgeladen werden können."
              }
            },
            {
              "id": "app-ScreenHasManyControls",
              "messageStrings": {
                "issue": {
                  "text": "Zu viele Steuerelemente auf einem Bildschirm."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Reduzieren Sie die Anzahl von Steuerelementen auf dem Bildschirm.",
                  "Alternativ dazu können Sie die App in weitere Bildschirme unterteilen, um die Komplexität pro Bildschirm zu verringern.",
                  "Verwenden Sie Komponenten, um gruppierte Steuerelemente zusammenzuführen, die auf allen Bildschirmen identisch sind, und so die Duplizierung zu reduzieren.",
                  "Verwenden Sie Kataloge, um eine Reihe sich wiederholender ähnlicher Steuerelemente darzustellen.",
                  "Teilen Sie die App in mehrere Apps auf, sodass jede App klein und leistungsfähig ist."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Jedes Steuerelement beansprucht Ressourcen, und eine App reagiert möglicherweise langsam oder gar nicht mehr, wenn ein Bildschirm zu viele Steuerelemente aufweist. Die geschätzte Komplexität von \"EditEFABOScreen\" ist 382 und überschreitet damit den maximal empfohlenen Schwellenwert (300)."
              }
            }
          ],
          "version": "1.346"
        }
      }
    }
  ],
  "version": "2.1.0"
}